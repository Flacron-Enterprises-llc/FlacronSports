rules_version = '2';

// All application data goes through server routes using the Admin SDK, which
// bypasses these rules. Browsers get no direct access, so a client can never
// write its own entitlement or read another user's records.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
